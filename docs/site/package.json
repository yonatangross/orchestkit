{
	"name": "orchestkit-docs",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"predev": "node ../../scripts/generate-docs-data.js && node scripts/lab-manifest.mjs --repo ../.. && node scripts/gen-related-graph.mjs && node scripts/gen-search-suggest-index.mjs",
		"dev": "next dev",
		"prebuild": "node scripts/lab-manifest.mjs --repo ../.. && node scripts/gen-related-graph.mjs && node scripts/gen-search-suggest-index.mjs",
		"build": "git fetch --unshallow 2>/dev/null || true; next build --webpack",
		"start": "next start",
		"postinstall": "fumadocs-mdx",
		"pretest": "node scripts/lab-manifest.mjs --repo ../.. && node scripts/gen-related-graph.mjs && node scripts/gen-search-suggest-index.mjs",
		"test": "vitest run -c vitest.site.config.ts",
		"test:watch": "vitest -c vitest.site.config.ts",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.1.0",
		"@orama/orama": "^3.1.18",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"@xyflow/react": "^12.12.0",
		"@yonatan-hq/analytics": "^1.2.0",
		"esbuild": "^0.28.1",
		"fumadocs-core": "16.17.4",
		"fumadocs-mdx": "^15.4.7",
		"fumadocs-ui": "16.17.4",
		"lucide-react": "^1.57.0",
		"motion": "^13.5.0",
		"next": "^16.4.2",
		"posthog-js": "^1.438.12",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@mdx-js/mdx": "^3.1.1",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"happy-dom": "^20.14.5",
		"magic-string": "^1.4.3",
		"postcss": "^8.5.30",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^4.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"optionalDependencies": {
		"@esbuild/darwin-x64": "^0.28.0"
	},
	"overrides": {
		"hono": "^4.12.18",
		"ip-address": "^10.2.0",
		"nanoid@<3.3.17": "^3.3.18",
		"postcss@<8.5.14": "^8.5.14",
		"sharp": "^0.35.5"
	}
}
