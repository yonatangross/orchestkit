# OrchestKit Docs — Environment Variables
# Copy to .env.local and fill in values (or use `op run --env-file=.env.tpl`).

# HMAC secret for analytics event signing (shared with HQ API)
ANALYTICS_HMAC_SECRET=

# HQ API base URL for analytics event ingestion
HQ_API_URL=https://api.example.com

# PostHog (EU cloud, project "OrchestKit"). MIRROR only — /api/analytics above
# stays the system of record. The phc_ project key is public by design.
# Leave blank locally: instrumentation-client.ts no-ops without it (and logs
# once in dev), so nothing breaks and no synthetic traffic reaches the project.
# NOTE: ingest host is eu.i.posthog.com (with the "i"); the app is eu.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
