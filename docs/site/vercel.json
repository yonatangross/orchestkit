{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "github": {
    "silent": true,
    "autoJobCancelation": true
  },
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- .",
  "installCommand": "bash scripts/vercel-install.sh"
}
