{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "release-please--**": false,
      "dependabot/**": false
    }
  },
  "github": {
    "silent": true,
    "autoJobCancelation": true
  },
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "installCommand": "bash scripts/vercel-install.sh",
  "crons": [{ "path": "/api/indexnow", "schedule": "0 6 * * *" }]
}
