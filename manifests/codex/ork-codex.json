      {
        "name": "context7",
        "transport": "http",
        "url": "https://mcp.context7.com/mcp",
        "bearerTokenEnvVar": "CONTEXT7_API_KEY_CODEX",
        "enabledTools": ["resolve-library-id", "query-docs"]
      }
    ]
  }
}
