#!/bin/bash
# Git Pre-push Hook for OrchestKit Plugin
# Mirrors CI version-check.yml - fail fast locally before pushing
# Version: 1.0.0

set -uo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# Drop the repository locators git exported to this hook, once, before any
# stage runs (#4070).
#
# From a linked worktree git runs this hook with GIT_DIR=<main>/.git/worktrees/
# <name> and no GIT_WORK_TREE. Every stage below spawns test fixtures, and a
# plain `git init` in a temp dir under that env re-initialises the MAIN
# repository: measured on git 2.54, it writes core.bare=true into the shared
# .git/config, after which git refuses to run in the primary checkout.
# Scrubbing fixture by fixture fixed one writer at a time; this fixes the
# boundary. git rediscovers the same repository from PROJECT_ROOT, and the
# locators stay exported only when it would not (a --git-dir push from a tree
# with no .git entry), in which case the tail guard still catches a flip.
drop_inherited_git_locators() {
  local located rediscovered
  located=$(git rev-parse --absolute-git-dir) || return 0
  if ! rediscovered=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
      -u GIT_COMMON_DIR -u GIT_OBJECT_DIRECTORY git rev-parse --absolute-git-dir); then
    echo "  WARNING: $PWD does not rediscover $located; keeping GIT_DIR for this push (#4070)"
    return 0
  fi
  if [[ "$(cd "$rediscovered" && pwd -P)" != "$(cd "$located" && pwd -P)" ]]; then
    echo "  WARNING: $PWD rediscovers $rediscovered, not $located; keeping GIT_DIR (#4070)"
    return 0
  fi
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
}

drop_inherited_git_locators

capture_initial_repo_config() {
  INITIAL_REPO_USER_EMAIL_SET=0
  INITIAL_REPO_USER_EMAIL=""
  if INITIAL_REPO_USER_EMAIL=$(git config --local --get user.email 2>/dev/null); then
    INITIAL_REPO_USER_EMAIL_SET=1
  fi
}

capture_initial_repo_config

# Resolve the branch actually being PUSHED, not the one checked out (#3290).
#
# git feeds pre-push one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
#
# `git rev-parse --abbrev-ref HEAD` returns the literal string "HEAD" in a
# DETACHED worktree, so the conventional-commit prefix exemptions below never
# matched and the version gate fired on branches that are explicitly exempt.
# That is not an edge case: git refuses to check out one branch in two
# worktrees, so pushing a branch another worktree holds REQUIRES detached HEAD
# plus `git push origin HEAD:<branch>`. The hook penalised the only safe way to
# do it, and left --no-verify looking like the way out — which would relocate
# the security suite this hook also runs, not skip it.
#
# Falls back to the old behaviour when stdin is a tty (hook run by hand) or
# carries no branch ref, so nothing changes for a normal push.
resolve_push_branch() {
  local lref lsha rref rsha branch=""
  if [ ! -t 0 ]; then
    while read -r lref lsha rref rsha; do
      [ -n "${rref:-}" ] || continue
      case "$rref" in
        refs/heads/*)
          branch="${rref#refs/heads/}"
          break
          ;;
      esac
    done
  fi
  [ -n "$branch" ] || branch=$(git rev-parse --abbrev-ref HEAD)
  printf '%s\n' "$branch"
}

BRANCH=$(resolve_push_branch)
REMOTE="$1"
REMOTE_URL="$2"

echo "Running pre-push validations for branch: $BRANCH"

# ===== Skip for branches release-please or Dependabot own =====
# The skip pattern lives in ONE file shared with version-check.yml (#1460,
# #1457); edit it there, never inline here. An unreadable or empty pattern is
# a failure, not a skip and not an enforce: the gate refuses to decide.
# shellcheck source=../../scripts/ci/version-skip-pattern.sh
if ! . "$PROJECT_ROOT/scripts/ci/version-skip-pattern.sh"; then
  echo "FAILED: cannot source scripts/ci/version-skip-pattern.sh"
  exit 1
fi
if [[ -z "${VERSION_SKIP_PATTERN:-}" ]]; then
  echo "FAILED: VERSION_SKIP_PATTERN is empty; scripts/ci/version-skip-pattern.sh must define it"
  exit 1
fi
# SKIP THE VERSION GATE, NOT THE HOOK (#4024).
#
# This said `exit 0`, which left the whole hook. VERSION_SKIP_PATTERN matches
# every conventional-commit prefix CONTRIBUTING tells contributors to use, so
# in practice EVERY feature push ran zero local tests: no unit suite, no
# security suite, no build, no manifests. The hook printed two lines and the
# push proceeded, which reads exactly like a hook that passed.
#
# That inverted this file's own purpose. The header at the top of this script
# exists to stop `--no-verify` relocating failures to CI, and this line was
# doing precisely that, silently, by default, for everyone.
SKIP_VERSION_GATE=0
if [[ "$BRANCH" =~ $VERSION_SKIP_PATTERN ]]; then
  echo "  Skipping version check for $BRANCH (release-please or Dependabot owns the version)"
  SKIP_VERSION_GATE=1
fi

# ===== Check if only non-code files changed =====
CHANGED_FILES=$(git diff --name-only origin/main...HEAD 2>/dev/null || git diff --name-only HEAD~1...HEAD)
CODE_CHANGES=$(echo "$CHANGED_FILES" | grep -vE '\.(md|txt)$|^docs/' || true)

if [[ -z "$CODE_CHANGES" ]]; then
  echo "  ✓ Skipping version check (only docs/config changes)"
  SKIP_VERSION_GATE=1
fi

# Fixed the same way as the branch gate above, and for a sharper reason: this
# hook runs an mdx-compile guard (tests/unit/test-mdx-compile.sh), which exists
# because a docs edit can break `next build` deep inside acorn. A docs-only
# diff is EXACTLY the diff that guard was written for, and `exit 0` here was
# skipping it for precisely that case.

# ===== Version Check =====
if [[ "$SKIP_VERSION_GATE" -eq 0 ]]; then
echo -n "  Checking version bump... "

# Get versions (plugin.json moved to plugins/ork/ in marketplace restructure)
PLUGIN_JSON="plugins/ork/.claude-plugin/plugin.json"
PR_VERSION=$(jq -r '.version' "$PROJECT_ROOT/$PLUGIN_JSON" 2>/dev/null || echo "")
MAIN_VERSION=$(git show "origin/main:$PLUGIN_JSON" 2>/dev/null | jq -r '.version' 2>/dev/null || echo "")

if [[ -z "$PR_VERSION" ]]; then
  echo "FAILED (cannot read version)"
  exit 1
fi

if [[ -z "$MAIN_VERSION" ]]; then
  echo "OK (new repo or no main branch)"
else
  if [[ "$PR_VERSION" == "$MAIN_VERSION" ]]; then
    echo "FAILED"
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║  Version not bumped! Current: $MAIN_VERSION"
    echo "╠════════════════════════════════════════════════════════════╣"
    echo "║  Run: ./bin/bump-version.sh patch"
    echo "╚════════════════════════════════════════════════════════════╝"
    exit 1
  fi

  # Verify branch version is GREATER than main (not just different).
  #
  # This used `sort -V`, which is not semver: it ranks a prerelease ABOVE the
  # release it precedes. During the v10 alpha train that reads 10.0.0-alpha.1 as
  # newer than 10.0.0, so a push moving the version backwards would pass.
  # shellcheck source=../../scripts/lib/semver.sh
  . "$(git rev-parse --show-toplevel)/scripts/lib/semver.sh"
  HIGHER=$(semver_max "$MAIN_VERSION" "$PR_VERSION")
  if [[ "$HIGHER" != "$PR_VERSION" ]]; then
    echo "FAILED"
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║  Version $PR_VERSION is not greater than main ($MAIN_VERSION)!"
    echo "╠════════════════════════════════════════════════════════════╣"
    echo "║  Did you branch before a release merged to main?"
    echo "║  Run: git fetch origin main && ./bin/bump-version.sh patch"
    echo "╚════════════════════════════════════════════════════════════╝"
    exit 1
  fi

  echo "OK ($MAIN_VERSION → $PR_VERSION)"
fi

# ===== Changelog Check =====
echo -n "  Checking CHANGELOG.md... "

# Note: git diff exits 1 when differences exist; pipefail would break the pipe.
# Capture output first to avoid pipefail interaction.
# Note: pipefail + "echo $big_var | grep -q" causes SIGPIPE when grep exits early.
# Use bash pattern matching instead.
_CL_FILES=$(git diff origin/main --name-only 2>/dev/null </dev/null || true)
if [[ "$_CL_FILES" != *"CHANGELOG.md"* ]]; then
  echo "FAILED"
  echo ""
  echo "╔════════════════════════════════════════════════════════════╗"
  echo "║  CHANGELOG.md not updated!"
  echo "╠════════════════════════════════════════════════════════════╣"
  echo "║  Run: ./bin/bump-version.sh patch"
  echo "║  Then edit CHANGELOG.md with your changes"
  echo "╚════════════════════════════════════════════════════════════╝"
  exit 1
fi
echo "OK"

# ===== Changelog Entry Check =====
echo -n "  Checking CHANGELOG entry for v$PR_VERSION... "

if ! grep -q "^\## \[$PR_VERSION\]" CHANGELOG.md; then
  echo "FAILED"
  echo ""
  echo "╔════════════════════════════════════════════════════════════╗"
  echo "║  CHANGELOG.md missing entry for version $PR_VERSION"
  echo "╠════════════════════════════════════════════════════════════╣"
  echo "║  Add: ## [$PR_VERSION] - $(date +%Y-%m-%d)"
  echo "╚════════════════════════════════════════════════════════════╝"
  exit 1
fi
echo "OK"

# ===== Version Sync Check =====
echo -n "  Checking version sync... "

PLUGIN_V=$(jq -r '.version' plugins/ork/.claude-plugin/plugin.json 2>/dev/null)
MARKET_V=$(jq -r '.version' .claude-plugin/marketplace.json 2>/dev/null)
PYPROJ_V=$(grep -E '^version\s*=' pyproject.toml 2>/dev/null | sed -E 's/.*"([^"]*)".*/\1/')

MISMATCH=0
[[ "$PLUGIN_V" != "$MARKET_V" ]] && MISMATCH=1
[[ "$PLUGIN_V" != "$PYPROJ_V" ]] && MISMATCH=1

if [[ $MISMATCH -eq 1 ]]; then
  echo "FAILED"
  echo "  plugin.json: $PLUGIN_V"
  echo "  marketplace.json: $MARKET_V"
  echo "  pyproject.toml: $PYPROJ_V"
  echo ""
  echo "  Run: ./bin/bump-version.sh patch"
  exit 1
fi
echo "OK (all at v$PLUGIN_V)"
fi  # SKIP_VERSION_GATE

# Probe stand-down. tests/ci/fault-arms/version-skip-pattern.sh runs this hook
# to read the version-gate DECISION above; it does not want the suites below.
# Without this, that probe ran the entire local pipeline inside the pre-commit
# lint step, and in a sandboxed worktree the pre-commit hook sat for 5+ minutes
# on every commit that touched src/hooks or src/skills (measured 2026-09-12:
# the lint suite passed in 3s standalone and hung only when its stdout+stderr
# went to /dev/null, the hook's condition; a 25s-alarm bisect of all 19 lint
# scripts and then of the 12 fault-arm probes isolated this one). Set ONLY by
# that probe. A real push never has it, so nothing below changes for a push.
if [[ "${ORK_PRE_PUSH_VERSION_GATE_ONLY:-}" == "1" ]]; then
  echo "  (ORK_PRE_PUSH_VERSION_GATE_ONLY: version-gate decision recorded, stopping before the suites)"
  exit 0
fi

# Everything below this line runs on EVERY push (#4024). It used to be
# unreachable for any conventionally-named branch.

# Cross-platform timeout function (defined early for use in all checks)
run_with_timeout() {
  local timeout_secs=$1
  shift
  if command -v timeout &>/dev/null; then
    timeout "$timeout_secs" "$@"
  elif command -v gtimeout &>/dev/null; then
    gtimeout "$timeout_secs" "$@"
  else
    # No timeout command available (macOS without coreutils).
    # Both perl alarm and background-process watchdog produce unreliable exit
    # codes with npm on macOS. Run directly — timeout protection is only
    # critical on CI where Linux `timeout` is available.
    "$@"
  fi
}

# Capture a stage's stdout and stderr under ${TMPDIR:-/tmp}.
# Success deletes the file. Failure leaves it and records the path in STAGE_LOG.
# A stage must not redirect to /dev/null: that is how the security failure
# hid its only red assertion (#4238).
STAGE_LOG=""
run_captured() {
  local log rc
  log=$(mktemp "${TMPDIR:-/tmp}/ork-pre-push.XXXXXX")
  # Status on the same line as the stage. A later $? (after if, or after a
  # pipeline) is not the stage's status: with no else, a failed if reports 0.
  "$@" >"$log" 2>&1; rc=$?
  if [[ "$rc" -eq 0 ]]; then
    rm -f "$log"
    STAGE_LOG=""
    return 0
  fi
  STAGE_LOG="$log"
  return "$rc"
}

print_kept_stage_log() {
  if [[ -z "${STAGE_LOG:-}" || ! -f "$STAGE_LOG" ]]; then
    return 0
  fi
  echo "║  Full log kept at: $STAGE_LOG"
  tail -20 "$STAGE_LOG" | sed 's/^/║  /'
}

# Second number of an uptime load tail: the 5-minute average.
# "82.44 124.65 117.59" and "0.52, 0.58, 0.59" both yield the middle field.
# Decimal commas become dots after the separator ", " is turned into a space.
load5_from_uptime_tail() {
  local line raw
  line=$(printf '%s' "$1" | sed 's/, / /g; s/,/./g')
  raw=$(printf '%s' "$line" | awk '{print $2}')
  [[ "$raw" =~ ^[0-9]+(\.[0-9]+)?$ ]] && printf '%s' "$raw"
  return 0
}

# Read the 5-minute load average once, or print nothing when it cannot be read.
#
# The 1-minute figure dips inside a single push, so two stages could see two
# policies. The sustained reading is the middle number: /proc/loadavg field 2,
# sysctl vm.loadavg field 2, uptime's second load number.
#
# macOS: `sysctl -n vm.loadavg` prints `{ 1.23 4.56 7.89 }`. `uptime` is the
# last resort because its format varies ("load average:" vs "load averages:")
# and because a sandbox that denies the sysctl syscall (measured 2026-09-13
# under the CC seatbelt: "Operation not permitted") still lets uptime through.
read_sustained_load() {
  local raw="" tail=""
  if [[ -r /proc/loadavg ]]; then
    raw=$(cut -d' ' -f2 /proc/loadavg 2>/dev/null)
  elif command -v sysctl &>/dev/null; then
    raw=$(sysctl -n vm.loadavg 2>/dev/null | tr -d '{}' | awk '{print $2}')
  fi
  if [[ -z "$raw" ]] && command -v uptime &>/dev/null; then
    tail=$(uptime 2>/dev/null | sed -n 's/.*load averages*: *//p')
    raw=$(load5_from_uptime_tail "$tail")
  fi
  [[ "$raw" =~ ^[0-9]+(\.[0-9]+)?$ ]] && printf '%s' "$raw"
  # Unreadable is a legitimate answer (empty), never a failing exit status.
  return 0
}

# Decide how many jobs a stage may run at once (#4085, #4238).
# Usage: resolve_pre_push_jobs <ncpu> <load>   (load may be empty)
#
# ORK_PRE_PUSH_JOBS wins when set to a positive integer. Otherwise the default
# is max(1, min(ncpu, 8, ncpu - round(load))). The caller passes the 5-minute
# load, read once. The old value was a bare 8, lowered only to hw.ncpu, with
# no load check: measured 2026-09-13 at 5-minute load 37, eight hook-spawning
# suites started at once on a machine already three times oversubscribed, and
# files that pass standalone in 11 s took 213 s and blew their own 5 s per-hook
# budgets. Backing off to what the machine can actually run keeps every gate
# in place and just stops the runner from being the thing that makes them flake.
#
# Pure arithmetic on its two arguments so tests/unit/test-pre-push-hook.sh can
# feed it a fake ncpu and an absurd load without touching the real machine.
resolve_pre_push_jobs() {
  local ncpu="$1" load1="${2:-}" jobs
  if [[ -n "${ORK_PRE_PUSH_JOBS:-}" ]]; then
    if [[ "$ORK_PRE_PUSH_JOBS" =~ ^[1-9][0-9]*$ ]]; then
      printf '%s' "$ORK_PRE_PUSH_JOBS"
      return 0
    fi
    echo "  WARN: ORK_PRE_PUSH_JOBS='$ORK_PRE_PUSH_JOBS' is not a positive integer, ignoring" >&2
  fi
  [[ "$ncpu" =~ ^[1-9][0-9]*$ ]] || ncpu=8
  jobs=$ncpu
  [[ $jobs -gt 8 ]] && jobs=8
  if [[ "$load1" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    # round(): add 0.5 and truncate. awk, because bash `((` cannot parse a
    # fractional load.
    local load_rounded
    load_rounded=$(awk -v l="$load1" 'BEGIN { printf "%d", l + 0.5 }')
    local headroom=$((ncpu - load_rounded))
    [[ $headroom -lt $jobs ]] && jobs=$headroom
  fi
  [[ $jobs -lt 1 ]] && jobs=1
  printf '%s' "$jobs"
}

# One notice, byte-identical, for every stage that receives MAX_JOBS.
# Printed only when load floored the count at 1. An explicit ORK_PRE_PUSH_JOBS
# and a 1-core box are not load, so they stay quiet.
PRE_PUSH_LOAD_NOTICE=""
refresh_pre_push_load_notice() {
  PRE_PUSH_LOAD_NOTICE=""
  [[ -n "${ORK_PRE_PUSH_JOBS:-}" ]] && return 0
  [[ "${MAX_JOBS:-}" == "1" ]] || return 0
  local idle
  idle=$(resolve_pre_push_jobs "$CORES" "")
  [[ "$idle" == "1" ]] && return 0
  PRE_PUSH_LOAD_NOTICE="pre-push: sustained load ${LOAD5}, jobs=1"
}

print_pre_push_load_notice() {
  [[ -n "$PRE_PUSH_LOAD_NOTICE" ]] && printf '%s\n' "$PRE_PUSH_LOAD_NOTICE"
}

# Read ncpu and the 5-minute load once. Args are the fixture's fake reading:
# plan_pre_push_jobs <ncpu> <load5>. No args: read this machine.
plan_pre_push_jobs() {
  if [[ $# -ge 1 ]]; then
    CORES="$1"
    LOAD5="${2-}"
  else
    if command -v nproc &>/dev/null; then
      CORES=$(nproc)
    elif command -v sysctl &>/dev/null; then
      CORES=$(sysctl -n hw.ncpu 2>/dev/null || echo 8)
    else
      CORES=8
    fi
    LOAD5=$(read_sustained_load)
  fi
  MAX_JOBS=$(resolve_pre_push_jobs "$CORES" "$LOAD5")
  refresh_pre_push_load_notice
}

# One reading for every stage below. A spike during this push must not pick
# a different width per stage.
plan_pre_push_jobs

# Unit files. The notice is its own line so it is not glued to the jobs banner.
run_unit_tests_parallel() {
  if [[ -n "$PRE_PUSH_LOAD_NOTICE" ]]; then
    printf '\n%s\n' "$PRE_PUSH_LOAD_NOTICE"
  fi
  printf '%s\n' "${CI_UNIT_TESTS[@]}" | xargs -P "$MAX_JOBS" -I {} bash -c '_run_test "$1"' _ {}
}

# Security runner. tests/security/run-security-tests.sh has no parallelism
# knob: it walks test-*.sh in one for-loop. jobs=1 is that serial walk. A
# wider count is not passed in, because there is no flag to pass, so the
# invocation stays the script alone either way.
# Always the checkout script. A PATH entry named run-security-tests.sh must
# not be able to report this stage OK.
run_security_stage() {
  local stage_rc
  print_pre_push_load_notice
  echo -n "  Running security tests... "
  if [[ -x "tests/security/run-security-tests.sh" ]]; then
    ORK_PRE_PUSH_STAGE_JOBS="$MAX_JOBS" run_captured ./tests/security/run-security-tests.sh; stage_rc=$?
    if [[ "$stage_rc" -ne 0 ]]; then
      echo "FAILED"
      echo ""
      echo "╔════════════════════════════════════════════════════════════╗"
      echo "║  Security tests failed!"
      echo "╠════════════════════════════════════════════════════════════╣"
      echo "║  Run: ./tests/security/run-security-tests.sh"
      print_kept_stage_log
      echo "╚════════════════════════════════════════════════════════════╝"
      exit "$stage_rc"
    fi
    echo "OK"
  else
    echo "SKIP (not found)"
  fi
}

# Hooks vitest. Same MAX_JOBS as the unit stage, via --maxWorkers (vitest 5).
# Skip when the local binary is absent so bare npx cannot fetch an unrelated
# npm package (#4220 HR-7 / IC-4). Still invoke via `npx vitest` when present
# so the GIT_* scrub + Test 9 argv probe stay intact; a local install means
# npx resolves without a network fetch.
run_hooks_vitest_stage() {
  print_pre_push_load_notice
  echo -n "  Running hook vitest suite... "
  HOOK_LOG="$(mktemp "${TMPDIR:-/tmp}/ork.XXXXXX")"
  if [[ ! -x src/hooks/node_modules/.bin/vitest ]]; then
    echo "SKIP (vitest not installed under src/hooks/node_modules/.bin)"
    rm -f "$HOOK_LOG"
    return 0
  fi
  if ! (cd src/hooks && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
      -u GIT_COMMON_DIR -u GIT_OBJECT_DIRECTORY npx vitest run --reporter=dot --maxWorkers="$MAX_JOBS" >"$HOOK_LOG" 2>&1); then
    LOG_KEEP_DIR=".cache/pre-push"
    mkdir -p "$LOG_KEEP_DIR"
    LOG_KEEP="$LOG_KEEP_DIR/hooks-vitest.log"
    cp "$HOOK_LOG" "$LOG_KEEP"
    echo "FAILED"
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║  Hooks vitest suite failed locally."
    echo "║  CI runs the same suite. Fix before push to avoid round-trips."
    echo "║  Full log kept at: $LOG_KEEP"
    echo "╠════════════════════════════════════════════════════════════╣"
    tail -20 "$HOOK_LOG" | sed 's/^/║  /'
    echo "╚════════════════════════════════════════════════════════════╝"
    exit 1
  fi
  rm -f "$HOOK_LOG"
  echo "OK"
}

assert_repo_config_unchanged() {
  if [[ "$(git config --bool core.bare 2>/dev/null || true)" == "true" ]]; then
    echo "FAILED: core.bare became true during pre-push validation"
    return 1
  fi

  local current_email_set=0 current_email=""
  if current_email=$(git config --local --get user.email 2>/dev/null); then
    current_email_set=1
  fi
  if [[ "$current_email_set" != "$INITIAL_REPO_USER_EMAIL_SET" ||
        "$current_email" != "$INITIAL_REPO_USER_EMAIL" ]]; then
    echo "FAILED: repo-local user.email changed during pre-push validation"
    return 1
  fi
}

# ===== TypeScript Type Check =====
echo -n "  Running TypeScript type check... "

if [[ -f "src/hooks/tsconfig.json" ]]; then
  # Prefer local binary; bare `npx tsc` can fetch the unrelated npm package
  # named `tsc` when typescript is absent (#4220 HR-7 / IC-4).
  if [[ ! -x src/hooks/node_modules/.bin/tsc ]]; then
    echo "SKIP (tsc not installed under src/hooks/node_modules/.bin)"
  else
    # Run the checked local binary under src/hooks (npx from repo root can
    # miss a checkout that only installed typescript there) (#4220 HR-7 / IC-4).
    run_captured run_with_timeout 120 src/hooks/node_modules/.bin/tsc --noEmit -p src/hooks/tsconfig.json; stage_rc=$?
    if [[ "$stage_rc" -ne 0 ]]; then
      echo "FAILED"
      echo ""
      echo "╔════════════════════════════════════════════════════════════╗"
      echo "║  TypeScript validation failed!"
      echo "╠════════════════════════════════════════════════════════════╣"
      echo "║  Run: cd src/hooks && ./node_modules/.bin/tsc --noEmit"
      print_kept_stage_log
      echo "╚════════════════════════════════════════════════════════════╝"
      exit "$stage_rc"
    fi
    echo "OK"
  fi
else
  echo "SKIP (no tsconfig.json)"
fi

# ===== Build Verification =====
echo -n "  Verifying build... "

run_captured run_with_timeout 300 npm run build; stage_rc=$?
if [[ "$stage_rc" -ne 0 ]]; then
  echo "FAILED"
  echo ""
  echo "╔════════════════════════════════════════════════════════════╗"
  echo "║  Build failed!"
  echo "╠════════════════════════════════════════════════════════════╣"
  echo "║  Run: npm run build"
  print_kept_stage_log
  echo "╚════════════════════════════════════════════════════════════╝"
  exit "$stage_rc"
fi
echo "OK"

# ===== Import Verification =====
echo -n "  Verifying imports... "

if [[ -f "scripts/verify-imports.js" ]]; then
  run_captured run_with_timeout 60 node scripts/verify-imports.js; stage_rc=$?
  if [[ "$stage_rc" -ne 0 ]]; then
    echo "FAILED"
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║  Import verification failed!"
