#!/bin/bash
# Git Commit-Message Hook for OrchestKit
# Enforces the Tone rule from CLAUDE.md: no sugarcoating in commit messages.
#
# Checks:
#   1. Title ≤ 72 characters
#   2. No banned celebratory phrases anywhere in the message
#
# Banned phrases are the ones that drift into commits when the author narrates
# the experience rather than stating the change. See anti-sycophancy.md.
#
# To bypass (use sparingly — with good reason): git commit --no-verify

set -uo pipefail

COMMIT_MSG_FILE="$1"
[[ -z "${COMMIT_MSG_FILE:-}" ]] && exit 0
[[ ! -f "$COMMIT_MSG_FILE" ]] && exit 0

# Skip merge / fixup / revert commits — they're mechanical
FIRST_LINE=$(head -n1 "$COMMIT_MSG_FILE")
if [[ "$FIRST_LINE" =~ ^(Merge|Revert|fixup!|squash!|amend!) ]]; then
    exit 0
fi

RED=$'\033[0;31m'
YELLOW=$'\033[1;33m'
NC=$'\033[0m'

ERRORS=0

# ───── Check 1: Title length ≤ 72 chars ─────────────────────────────
TITLE_LEN=${#FIRST_LINE}
if [[ $TITLE_LEN -gt 72 ]]; then
    echo "${RED}✗${NC} Commit title is ${TITLE_LEN} chars (max 72)"
    echo "  Title: $FIRST_LINE"
    echo "  Trim to the verb + object. Move detail to the body."
    ERRORS=$((ERRORS + 1))
fi

# ───── Check 2: Banned celebratory phrases ──────────────────────────
# State the change, don't narrate the feeling.
MSG_BODY=$(cat "$COMMIT_MSG_FILE")

# Strip comment lines (git includes guidance in the editor) before scanning
MSG_SCAN=$(printf '%s\n' "$MSG_BODY" | sed '/^#/d')

# Banned patterns (case-insensitive). Match whole phrases/words.
BANNED_PATTERNS=(
    'shipped cleanly'
    'all green!'
    'all green 🎯'
    'fully closed'
    'closed cleanly'
    'ready to ship!'
    'works beautifully'
    'thoroughly green'
    'pays back handsomely'
    '🎉'
    '🚀'
    '🎯'
    '✨'
)

FOUND=()
for pat in "${BANNED_PATTERNS[@]}"; do
    if grep -qiF "$pat" <<<"$MSG_SCAN" 2>/dev/null; then
        FOUND+=("$pat")
    fi
done

if [[ ${#FOUND[@]} -gt 0 ]]; then
    echo "${RED}✗${NC} Banned celebratory phrases in commit message:"
    for f in "${FOUND[@]}"; do
        echo "    → \"$f\""
    done
    echo "  Rewrite as a factual statement. See CLAUDE.md § Tone."
    ERRORS=$((ERRORS + 1))
fi

# ───── Soft signal: body > 50 lines (warning, not failure) ──────────
BODY_LINES=$(wc -l <"$COMMIT_MSG_FILE" | tr -d ' ')
if [[ $BODY_LINES -gt 50 ]]; then
    echo "${YELLOW}⚠${NC}  Commit body is $BODY_LINES lines. Consider trimming narrative."
fi

if [[ $ERRORS -gt 0 ]]; then
    echo ""
    echo "Commit blocked. Fix the above and try again."
    echo "(Bypass with --no-verify only for good reason.)"
    exit 1
fi

# ───── Check 3: provenance trailer stamp (hq six-key standard) ──────
# Lane context = HQ_* env or a herdr seat; a plain human commit passes
# unstamped. In lane context, refuse only when Harness, Seat or Account
# cannot be resolved; Model/Effort/Session fall back to na / a per-
# worktree generated id.
if [[ -n "${HQ_LANE:-}${HQ_ENGINE:-}${HERDR_ENV:-}${CLAUDECODE:-}" ]]; then
    P_ACCOUNT="${HQ_ACCOUNT:-}"
    if [[ -z "$P_ACCOUNT" ]]; then
        P_ACCOUNT=$(jq -r '.oauthAccount.emailAddress // empty' "$HOME/.claude.json" 2>/dev/null)
    fi
    [[ -n "$P_ACCOUNT" ]] || P_ACCOUNT=$(gh api user --jq .login 2>/dev/null)
    [[ -n "$P_ACCOUNT" ]] || P_ACCOUNT=$(git config user.email 2>/dev/null)

    P_HARNESS="${HQ_ENGINE:-}"
    if [[ -z "$P_HARNESS" ]]; then
        p=$PPID; i=0
        while [[ $i -lt 8 && -n "$p" && "$p" != "1" ]]; do
            c=$(ps -o comm= -p "$p" 2>/dev/null | tr '[:upper:]' '[:lower:]')
            case "$c" in
                *claude*) P_HARNESS=cc; break ;;
                *devin*)  P_HARNESS=devin; break ;;
                *codex*)  P_HARNESS=codex; break ;;
                *cursor*) P_HARNESS=cursor; break ;;
                *gemini*) P_HARNESS=gemini; break ;;
                *muse*)   P_HARNESS=muse; break ;;
                pi|*/pi)  P_HARNESS=pi; break ;;
            esac
            p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
            i=$((i + 1))
        done
    fi
    [[ -n "$P_HARNESS" ]] || { [[ -n "${CLAUDECODE:-}" ]] && P_HARNESS=cc; }

    P_MODEL="${HQ_MODEL:-na}"
    P_EFFORT="${HQ_EFFORT:-na}"
    P_SEAT="${HQ_LANE:-}"
    [[ -n "$P_SEAT" ]] || P_SEAT=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null)

    P_SESSION="${HQ_SESSION:-${CLAUDE_SESSION_ID:-${DEVIN_SESSION_ID:-}}}"
    if [[ -z "$P_SESSION" ]]; then
        gd=$(git rev-parse --git-dir 2>/dev/null)
        sf="$gd/hq-session"
        if [[ -n "$gd" && ! -f "$sf" ]]; then
            { uuidgen 2>/dev/null || date +%s%N; } | shasum | cut -c1-10 >"$sf" 2>/dev/null
        fi
        [[ -f "$sf" ]] && P_SESSION=$(cat "$sf" 2>/dev/null)
    fi
    P_SESSION=$(printf '%s' "${P_SESSION:-na}" | cut -c1-12)

    MISSING=""
    [[ -n "$P_HARNESS" ]] || MISSING="$MISSING Harness"
    [[ -n "$P_SEAT" ]]    || MISSING="$MISSING Seat"
    [[ -n "$P_ACCOUNT" ]] || MISSING="$MISSING Account"
    if [[ -n "$MISSING" ]]; then
        echo "${RED}✗${NC} provenance: lane context but unresolvable:$MISSING"
        echo "  fix: export the HQ_* var for each missing key (HQ_ENGINE=cc|pi|codex|devin|cursor|gemini|muse, HQ_LANE=<lane>) and retry"
        exit 1
    fi
    git interpret-trailers --in-place \
        --if-exists replace --trailer "Account: $P_ACCOUNT" \
        --if-exists replace --trailer "Harness: $P_HARNESS" \
        --if-exists replace --trailer "Model: $P_MODEL" \
        --if-exists replace --trailer "Effort: $P_EFFORT" \
        --if-exists replace --trailer "Seat: $P_SEAT" \
        --if-exists replace --trailer "Session: $P_SESSION" \
        "$COMMIT_MSG_FILE"
fi

exit 0
