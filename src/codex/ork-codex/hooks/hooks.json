{
  "description": "Disabled-by-default Jev passive observation. Each hook exits at once unless an operator explicitly sets JEV_SHADOW_ROOT; this file changes no Codex settings by itself.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/jev-shadow-hook.mjs\" SessionStart",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/jev-shadow-hook.mjs\" UserPromptSubmit",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/jev-shadow-hook.mjs\" PreToolUse",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/jev-shadow-hook.mjs\" PostToolUse",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
