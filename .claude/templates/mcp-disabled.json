{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/schemas/mcp.schema.json",
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "description": "Up-to-date documentation for frameworks and libraries. Disabling this degrades 22 of 36 ork agents to training-data answers with no error raised.",
      "disabled": true
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "description": "Complex reasoning and architectural decision support",
      "disabled": true
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "description": "Local file-based memory via knowledge graph",
      "disabled": true
    },
    "tavily": {
      "command": "sh",
      "args": [
        "-c",
        "TAVILY_API_KEY=$(op read 'op://<vault>/<item>/<field>') exec npx -y tavily-mcp@latest"
      ],
      "description": "Web search, extract, crawl, and deep research (requires API key)",
      "disabled": true
    },
    "portless": {
      "command": "/opt/homebrew/bin/portless",
      "args": ["mcp"],
      "description": "Named HTTPS .localhost URLs for dev servers",
      "disabled": true
    },
    "emulate": {
      "command": "/opt/homebrew/bin/emulate",
      "args": ["mcp"],
      "description": "Stateful API emulation for tests",
      "disabled": true
    },
    "agent-browser": {
      "command": "/opt/homebrew/bin/agent-browser",
      "args": ["mcp", "--tools", "core"],
      "env": {
        "AGENT_BROWSER_ARGS": "--mute-audio,--use-mock-keychain,--password-store=basic",
        "AGENT_BROWSER_SESSION": "ork-mcp-cc",
        "AGENT_BROWSER_NAMESPACE": "abmcp-ork",
        "AGENT_BROWSER_PIN_TAB": "1"
      },
      "description": "Browser automation, core profile",
      "disabled": true
    }
  }
}
