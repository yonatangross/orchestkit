{
  "description": "OrchestKit hooks - 151 global + 0 agent-scoped + 12 skill-scoped = 163 total hooks. Agent-scoped is 0 by design since #3461: CC's plugin-agent loader ignores `hooks:` in frontmatter, so ork's own 45 declarations never fired and were removed. The key still works in a consumer's own .claude/agents/, which is what the agent-hooks skill documents. Registry history lives in README.md (Registry changelog) - do not append changelog prose here, only re-stamp the counts.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 60,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.mjs",
              "pretool/tool-dispatcher"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:Agent|Read|Bash|Grep|Glob|Write|Edit|TaskUpdate|TaskCreate|Skill|NotebookEdit|WebFetch|WebSearch)$|(?:mcp__*)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 60,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.mjs",
              "posttool/tool-dispatcher"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Write|Edit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "statusMessage": "Analyzing failure...",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.mjs",
              "posttool/failure-handler"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "async": true,
            "timeout": 15,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/bin/run-hook.mjs",
              "lifecycle/webhook-forwarder"
            ]
          }
        ]
      }
    ],
